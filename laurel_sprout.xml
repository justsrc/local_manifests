<?xml version="1.0" encoding="UTF-8" ?>
<!--
  EvoX bka (LineageOS 23.2 / Android 16) local manifest for Xiaomi Mi A3.

  From Evolution-X/manifest@bka/default.xml:
    <default revision="refs/heads/lineage-23.2">
    revision="refs/tags/android-16.0.0_r4"

  The EvoX manifest declares no device/xiaomi projects, so all six device repos
  below arrive through this file. It gets cloned into .repo/local_manifests by
  the crave run command.
-->
<manifest>
  <!-- remotes -->
  <remote name="justsrc" fetch="https://github.com/justsrc" />
  <remote name="evodev" fetch="https://github.com/Evolution-X-Devices" />
  <remote name="themuppets" fetch="https://github.com/TheMuppets" />

  <!-- device trees -->
  <project
        path="device/xiaomi/laurel_sprout"
        name="device_xiaomi_laurel_sprout"
        remote="justsrc"
        revision="bka-23.2"
        clone-depth="1"
    />
  <project
        path="device/xiaomi/sm6125-common"
        name="device_xiaomi_sm6125-common"
        remote="justsrc"
        revision="bka-23.2"
        clone-depth="1"
    />

  <!-- hardware tree, upstream EvoX bka -->
  <project
        path="hardware/xiaomi"
        name="hardware_xiaomi"
        remote="evodev"
        revision="bka"
        clone-depth="1"
    />

  <!-- kernel tree -->
  <project
        path="kernel/xiaomi/sm6125"
        name="kernel_xiaomi_sm6125"
        remote="justsrc"
        revision="bka"
        clone-depth="1"
    />

  <!-- stock blobs -->
  <project
        path="vendor/xiaomi/laurel_sprout"
        name="proprietary_vendor_xiaomi_laurel_sprout"
        remote="themuppets"
        revision="lineage-23.2"
        clone-depth="1"
    />

  <!-- EvoX vendor tree -->
  <project
        path="vendor/xiaomi/sm6125-common"
        name="vendor_xiaomi_sm6125-common"
        remote="evodev"
        revision="bka"
        clone-depth="1"
    />
</manifest>
